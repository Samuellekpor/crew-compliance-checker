# Copy this file to .streamlit/secrets.toml (never commit secrets.toml).
# Streamlit reads these automatically in both local runs and Community Cloud.
#
# Lead capture — Mailchimp (primary)
# ──────────────────────────────────
# 1. Mailchimp → Account → Extras → API Keys → Create A Key
#    The key ends with a server suffix such as "-us14".
# 2. Mailchimp → Audience → Settings → Audience name and defaults → Audience ID
# 3. Create merge fields on the audience (Audience → Settings → Audience fields):
#      ROLE, INTEREST, FRAMEWORK, SAMPLE, REPORT, SOURCE
#    Missing merge fields cause a soft API warning; the app still unlocks the report.
#
# Lead capture — n8n (optional enrichment / report delivery)
# ─────────────────────────────────────────────────────────
# Paste a Production webhook URL from an n8n workflow that accepts JSON POSTs.
# If unset, n8n is skipped silently.
#
# Without Mailchimp and n8n configured, the lead form still unlocks PDF/Excel
# locally so development and demos are not blocked.

MAILCHIMP_API_KEY = "your-api-key-us14"
MAILCHIMP_LIST_ID = "your-audience-id"
N8N_LEAD_WEBHOOK_URL = "https://your-n8n.example/webhook/crew-compliance-lead"
