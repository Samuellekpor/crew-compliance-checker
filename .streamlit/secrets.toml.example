# Copy this file to .streamlit/secrets.toml (never commit secrets.toml).
# Streamlit reads these automatically in both local runs and Community Cloud.
#
# Mailchimp lead-capture
# ──────────────────────
# 1. Mailchimp → Account → Extras → API Keys → Create A Key
#    The key ends with "-us14" (or similar); the suffix is the server prefix.
# 2. Mailchimp → Audience → All contacts → Settings → Audience name and defaults
#    → Audience ID  (looks like "a1b2c3d4e5")
#
# Without these values the email form still appears but submissions are not
# forwarded to Mailchimp and the user is not blocked.

MAILCHIMP_API_KEY = "your-api-key-us14"
MAILCHIMP_LIST_ID = "your-audience-id"
